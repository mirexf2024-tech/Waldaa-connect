rules_version = '2';
// WALDAA CONNECT GLOBAL: FREE-PLAN (Spark) rules. No Cloud Functions: these rules are the server-side authority.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isDeveloper() {
      return signedIn() && (request.auth.token.developer == true
        || exists(/databases/$(database)/documents/developers/$(request.auth.uid)));
    }
    function allRoles() { return ['pastor','secretary','finance','choir','prayer','auditor','member']; }
    function memberDoc(churchId) {
      return get(/databases/$(database)/documents/churches/$(churchId)/members/$(request.auth.uid));
    }
    function hasChurchRole(churchId, roles) {
      return signedIn() && memberDoc(churchId).data.status == 'active' && memberDoc(churchId).data.role in roles;
    }
    function appDoc(id) { return get(/databases/$(database)/documents/churchApplications/$(id)).data; }
    function inviteDoc(id) { return get(/databases/$(database)/documents/invites/$(id)).data; }
    // First sign-in after developer approval: the applicant becomes pastor of the approved church.
    function claimsAsPastor(d, cid) {
      return verified() && d.keys().hasAny(['applicationId'])
        && appDoc(d.applicationId).applicantUid == request.auth.uid
        && appDoc(d.applicationId).status == 'approved'
        && appDoc(d.applicationId).churchId == cid
        && d.role == 'pastor' && d.status == 'active';
    }
    // First sign-in of an invited person (invite id = their verified email).
    function claimsAsInvitee(d, cid) {
      return verified() && d.keys().hasAny(['inviteId'])
        && d.inviteId == request.auth.token.email.lower()
        && inviteDoc(d.inviteId).status == 'pending'
        && inviteDoc(d.inviteId).churchId == cid
        && inviteDoc(d.inviteId).role == d.role
        && d.status == 'active';
    }
    function validMoney(d) {
      return d.keys().hasAll(['amount', 'type', 'createdBy'])
        && d.amount is number && d.amount > 0 && d.amount < 1000000000
        && d.type in ['tithe', 'offering', 'donation', 'income', 'expense']
        && d.createdBy == request.auth.uid;
    }

    // ---------- developers (create documents ONLY from Firebase Console) ----------
    match /developers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- app customization (public read, Developer-only write) ----------
    match /appConfig/{docId} {
      allow read: if true;
      allow create, update: if isDeveloper() && docId == 'main'
        && request.resource.data.keys().hasOnly(['brand','sub','greeting','verseText','verseRef','primary','gold','scale','radius','density','hidden','labels','updatedAt','updatedBy'])
        && request.resource.data.brand is string && request.resource.data.brand.size() >= 1 && request.resource.data.brand.size() <= 40
        && request.resource.data.scale is number && request.resource.data.scale >= 85 && request.resource.data.scale <= 125
        && request.resource.data.radius is number && request.resource.data.radius >= 6 && request.resource.data.radius <= 30
        && request.resource.data.density in ['compact','normal','comfortable']
        && request.resource.data.primary.matches('^#[0-9a-fA-F]{6}$') && request.resource.data.gold.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isDeveloper() && docId == 'main';
    }

    // ---------- church applications ----------
    match /churchApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
        && request.resource.data.city is string && request.resource.data.country is string
        && request.resource.data.pastor is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['name','city','country','pastor','email','language','estimatedMembers','applicantUid','status','createdAt','schemaVersion']);
      allow read: if signedIn() && (resource.data.applicantUid == request.auth.uid || isDeveloper());
      allow update: if isDeveloper() && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','churchId','approvedAt','approvedBy','rejectionReason','rejectedBy','rejectedAt']);
      allow delete: if false;
    }

    // ---------- invites (pastor invites by email; the person claims after verifying that email) ----------
    match /invites/{emailId} {
      allow create: if signedIn()
        && emailId.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && emailId == emailId.lower()
        && request.resource.data.keys().hasOnly(['churchId','role','name','phone','status','createdBy','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.role in ['secretary','finance','choir','prayer','auditor','member']
        && hasChurchRole(request.resource.data.churchId, ['pastor']);
      allow read: if signedIn() && ((verified() && request.auth.token.email.lower() == emailId)
        || hasChurchRole(resource.data.churchId, ['pastor']));
      allow update: if (hasChurchRole(resource.data.churchId, ['pastor']) && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','name','phone']))
        || (verified() && request.auth.token.email.lower() == emailId && request.resource.data.status == 'claimed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','claimedBy','claimedAt']));
      allow delete: if false;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid
        && (claimsAsPastor(request.resource.data, request.resource.data.churchId)
            || claimsAsInvitee(request.resource.data, request.resource.data.churchId));
      allow update: if hasChurchRole(resource.data.churchId, ['pastor']) && resource.data.role != 'pastor'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','role'])
        && request.resource.data.role in ['secretary','finance','choir','prayer','auditor','member'];
      allow delete: if false;
    }

    // ---------- auditLogs (Developer actions) ----------
    match /auditLogs/{logId} {
      allow read: if isDeveloper();
      allow create: if isDeveloper() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- churches ----------
    match /churches/{churchId} {
      allow read: if isDeveloper() || hasChurchRole(churchId, allRoles());
      allow create: if isDeveloper() && request.resource.data.status == 'approved';
      allow update: if isDeveloper();
      allow delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isDeveloper() || hasChurchRole(churchId, ['pastor','secretary']));
        allow create: if signedIn() && request.auth.uid == uid
          && (claimsAsPastor(request.resource.data, churchId) || claimsAsInvitee(request.resource.data, churchId));
        allow update: if hasChurchRole(churchId, ['pastor']) && resource.data.role != 'pastor'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','role'])
          && request.resource.data.role in ['secretary','finance','choir','prayer','auditor','member'];
        allow delete: if false;
      }

      // Names and roles only (no email/phone): lets members start chats.
      match /directory/{uid} {
        allow read: if isDeveloper() || hasChurchRole(churchId, allRoles());
        allow create: if signedIn() && request.auth.uid == uid
          && (claimsAsPastor(request.resource.data, churchId) || claimsAsInvitee(request.resource.data, churchId));
        allow update: if hasChurchRole(churchId, ['pastor']) && resource.data.role != 'pastor'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','role'])
          && request.resource.data.role in ['secretary','finance','choir','prayer','auditor','member'];
        allow delete: if false;
      }

      match /announcements/{itemId} {
        allow read: if hasChurchRole(churchId, allRoles());
        allow write: if hasChurchRole(churchId, ['pastor','secretary']);
      }

      match /prayers/{itemId} {
        allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid
          || (resource.data.visibility == 'community' && hasChurchRole(churchId, ['pastor','prayer','member']))
          || hasChurchRole(churchId, ['pastor','prayer']));
        allow create: if hasChurchRole(churchId, allRoles()) && request.resource.data.ownerUid == request.auth.uid;
        allow update: if hasChurchRole(churchId, ['pastor','prayer']);
        allow delete: if hasChurchRole(churchId, ['pastor','prayer']) || (signedIn() && resource.data.ownerUid == request.auth.uid);
      }

      match /choir/{itemId} {
        allow read: if hasChurchRole(churchId, ['pastor','choir','member']);
        allow write: if hasChurchRole(churchId, ['pastor','choir']);
      }

      // Finance ledger: append-only. Corrections = new reversing entry.
      match /finance/{recordId} {
        allow read: if hasChurchRole(churchId, ['pastor','finance','auditor']);
        allow create: if hasChurchRole(churchId, ['pastor','finance']) && validMoney(request.resource.data);
        allow update, delete: if false;
      }

      match /paymentRefs/{refId} {
        allow create: if hasChurchRole(churchId, allRoles())
          && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending'
          && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount < 1000000000;
        allow read: if hasChurchRole(churchId, ['pastor','finance','auditor']) || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if hasChurchRole(churchId, ['pastor','finance'])
          && request.resource.data.status in ['verified', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','verifiedBy','verifiedAt','note']);
        allow delete: if false;
      }

      // ---------- v10: giving details, calendar, families, Sunday school, pastoral care ----------
      match /settings/{docId} {
        allow read: if hasChurchRole(churchId, allRoles());
        allow create, update: if docId == 'giving' && hasChurchRole(churchId, ['pastor'])
          && request.resource.data.keys().hasOnly(['accounts','telebirr','note','updatedAt','updatedBy'])
          && request.resource.data.accounts.size() <= 10 && request.resource.data.telebirr.size() <= 10
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }

      match /events/{eventId} {
        function evWriter(d) { return hasChurchRole(churchId, ['pastor','secretary']) || (hasChurchRole(churchId, ['choir']) && d.category == 'choir'); }
        function evOk(d) {
          return d.keys().hasOnly(['title','date','time','place','notes','category','createdBy','createdAt','updatedAt'])
            && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
            && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.category in ['service','youth','choir','women','men','other'];
        }
        allow read: if hasChurchRole(churchId, allRoles());
        allow create: if evWriter(request.resource.data) && evOk(request.resource.data) && request.resource.data.createdBy == request.auth.uid;
        allow update: if evWriter(resource.data) && evWriter(request.resource.data) && evOk(request.resource.data);
        allow delete: if evWriter(resource.data);
      }

      match /people/{personId} {
        allow read: if hasChurchRole(churchId, ['pastor','secretary']);
        allow create, update: if hasChurchRole(churchId, ['pastor','secretary'])
          && request.resource.data.keys().hasOnly(['name','phone','family','status','servant','ministry','followStatus','nextFollowUp','followNote','createdBy','createdAt','updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
          && request.resource.data.status in ['member','newcomer','visitor']
          && request.resource.data.followStatus in ['new','contacted','visited','joined']
          && request.resource.data.servant is bool;
        allow delete: if hasChurchRole(churchId, ['pastor']);
      }

      match /classes/{classId} {
        allow read: if hasChurchRole(churchId, allRoles());
        allow create, update: if hasChurchRole(churchId, ['pastor','secretary'])
          && request.resource.data.keys().hasOnly(['name','kind','teacher','day','time','place','createdBy','createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
          && request.resource.data.kind in ['sundayschool','biblestudy'];
        allow delete: if hasChurchRole(churchId, ['pastor','secretary']);
        match /students/{studentId} {
          allow read, write: if hasChurchRole(churchId, ['pastor','secretary'])
            && (request.method == 'delete' || (request.resource.data.name is string && request.resource.data.name.size() <= 100));
        }
        match /sessions/{day} {
          allow read: if hasChurchRole(churchId, ['pastor','secretary']);
          allow create, update: if hasChurchRole(churchId, ['pastor','secretary'])
            && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.keys().hasOnly(['date','present','by','updatedAt'])
            && request.resource.data.present is list && request.resource.data.present.size() <= 300;
          allow delete: if false;
        }
      }

      match /care/{careId} {
        allow read: if hasChurchRole(churchId, ['pastor']) || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if hasChurchRole(churchId, allRoles())
          && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'requested'
          && request.resource.data.keys().hasOnly(['uid','name','topic','details','preferred','status','createdAt'])
          && request.resource.data.topic in ['counseling','marriage','family','prayer','other']
          && request.resource.data.details is string && request.resource.data.details.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if (hasChurchRole(churchId, ['pastor'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','scheduledAt','replyNote','updatedAt'])
            && request.resource.data.status in ['scheduled','done','declined'])
          || (signedIn() && resource.data.uid == request.auth.uid && hasChurchRole(churchId, allRoles())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
            && request.resource.data.status == 'cancelled');
        allow delete: if false;
      }

      // ---------- chat (client-side, no functions) ----------
      match /chats/{chatId} {
        function chat() { return get(/databases/$(database)/documents/churches/$(churchId)/chats/$(chatId)).data; }
        function isChannel(d) { return d.type == 'channel'; }
        allow read: if signedIn() && (request.auth.uid in resource.data.members
          || (resource.data.type == 'channel' && hasChurchRole(churchId, allRoles())));
        allow create: if hasChurchRole(churchId, allRoles())
          && request.resource.data.keys().hasOnly(['type','name','members','names','createdBy','createdAt','lastAt','lastMessage'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time && request.resource.data.lastAt == request.time
          && request.resource.data.lastMessage == null
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() <= 200
          && request.resource.data.type in ['direct','group','channel']
          && (request.resource.data.type == 'direct'
                ? (request.resource.data.members.size() == 2
                   && chatId == 'dm_' + request.resource.data.members[0] + '_' + request.resource.data.members[1])
                : (hasChurchRole(churchId, ['pastor','secretary'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80));
        allow update: if hasChurchRole(churchId, allRoles())
          && (request.auth.uid in resource.data.members || (resource.data.type == 'channel' && hasChurchRole(churchId, ['pastor','secretary'])))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastAt'])
          && request.resource.data.lastMessage.senderUid == request.auth.uid
          && request.resource.data.lastAt == request.time;
        allow delete: if false;

        match /messages/{msgId} {
          allow read: if signedIn() && (request.auth.uid in chat().members
            || (chat().type == 'channel' && hasChurchRole(churchId, allRoles())));
          allow create: if hasChurchRole(churchId, allRoles())
            && (chat().type == 'channel' ? hasChurchRole(churchId, ['pastor','secretary']) : request.auth.uid in chat().members)
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.text is string && request.resource.data.text.size() <= 4000
            && (request.resource.data.text.size() > 0 || request.resource.data.keys().hasAny(['attachment']))
            && request.resource.data.keys().hasOnly(['text','senderUid','createdAt','replyTo','attachment'])
            && (!request.resource.data.keys().hasAny(['attachment'])
                || (request.resource.data.attachment.url is string
                    && request.resource.data.attachment.url.matches('https://res\\.cloudinary\\.com/.*')
                    && request.resource.data.attachment.kind in ['image','audio','file']));
          allow update: if signedIn() && resource.data.senderUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted']);
          allow delete: if false;
        }
      }

      match /chatReads/{uid} {
        allow read, write: if signedIn() && request.auth.uid == uid && hasChurchRole(churchId, allRoles());
      }
    }

    // ---------- Bible text (Developer imports PDF text per chapter; every signed-in user reads) ----------
    match /bibleVersions/{vid} {
      allow read: if signedIn();
      allow create: if isDeveloper()
        && request.resource.data.keys().hasOnly(['name','lang','rights','createdBy','createdAt'])
        && request.resource.data.lang in ['om','am','en'] && request.resource.data.rights == true
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isDeveloper();
      match /chapters/{chId} {
        allow read: if signedIn();
        allow create, update: if isDeveloper()
          && request.resource.data.keys().hasOnly(['book','chapter','verses','by','updatedAt'])
          && request.resource.data.book is int && request.resource.data.book >= 0 && request.resource.data.book < 66
          && request.resource.data.chapter is int && request.resource.data.chapter >= 1 && request.resource.data.chapter <= 150
          && chId == string(request.resource.data.book) + '_' + string(request.resource.data.chapter)
          && request.resource.data.verses is list && request.resource.data.verses.size() >= 1 && request.resource.data.verses.size() <= 250;
        allow delete: if isDeveloper();
      }
    }

    // ---------- v10 global: Developer support details + ads (Developer writes, signed-in users read) ----------
    match /supportInfo/{docId} {
      allow read: if signedIn();
      allow create, update: if isDeveloper() && docId == 'giving'
        && request.resource.data.keys().hasOnly(['accounts','telebirr','note','updatedAt','updatedBy'])
        && request.resource.data.accounts.size() <= 10 && request.resource.data.telebirr.size() <= 10
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isDeveloper();
    }
    match /ads/{adId} {
      allow read: if signedIn();
      allow create, update: if isDeveloper()
        && request.resource.data.keys().hasOnly(['title','text','link','active','createdBy','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
        && request.resource.data.active is bool
        && (request.resource.data.link == '' || request.resource.data.link.matches('^https://[^ ]+$'));
      allow delete: if isDeveloper();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
